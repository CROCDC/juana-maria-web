.claude/

# Media uploaded from the content editor (flask-sitecopy). Written at runtime under
# the served static folder; user content, kept on a volume, never committed.
public/static/sitecopy-uploads/

# Source media library (raw/working assets). NOT served by the app (it uses
# app/static/), and too large for GitHub (a single file exceeds the 100MB limit).
# Keep these out of the repo; use git-lfs or external storage if you need them tracked.
media/
media-web/

# Vercel project link.
.vercel/

# VERCEL_OIDC_TOKEN, written by `vercel link`.
.env.local
