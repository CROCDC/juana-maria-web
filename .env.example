FLASK_APP=wsgi.py
FLASK_DEBUG=1

# Postgres connection string. In production this is Neon's POOLED endpoint, injected
# by Vercel; `flask db upgrade` runs against the unpooled one (see docs/deploy/VERCEL.md).
# For local dev, point it at a local Postgres:
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# Umami analytics (public website id; not a secret).
UMAMI_WEBSITE_ID=b5d4b173-a160-49f5-8f0d-076e804d0007

# Public canonical origin. Set in production so alias hosts 301 here and SEO
# URLs (canonical/OG/sitemap/robots) are emitted on this origin regardless of
# which host served the request. Leave unset in dev to use the request's origin.
CANONICAL_URL=https://velaclasica.ar
# Hosts that 301-redirect to CANONICAL_URL (comma-separated; www + the internal
# nexttech subdomain). Leave unset in dev so no redirect happens.
REDIRECT_HOSTS=www.velaclasica.ar,juana-maria.nexttech.com.ar

# Admin panel (topic visibility). SECRET_KEY signs the session cookie and
# ADMIN_PASSWORD gates /admin. Both are secrets — in production they live in the
# Vercel project's environment variables, never committed. If ADMIN_PASSWORD is unset
# the admin panel can't be logged into.
SECRET_KEY=076e804d0007-b5d4b173-49f5-8f0d-vedsdf-1234567890
ADMIN_PASSWORD=admin

# Editor uploads on Vercel. When set, sitecopy's file store writes to Vercel Blob
# instead of the static folder (a function's filesystem is read-only). Injected by
# Vercel when the Blob store is attached to the project; leave it unset locally, where
# uploads land under public/static/sitecopy-uploads.
BLOB_READ_WRITE_TOKEN=

# Alerts (docs/deploy/MONITORING.md). RESEND_API_KEY is a secret and lives in the
# Vercel project's environment; ALERT_EMAIL_FROM must be on a domain verified in
# Resend. With any of the three unset, alerting is a logged no-op — the site still
# works, it just stops telling anybody when it breaks.
RESEND_API_KEY=
ALERT_EMAIL_TO=crocdc1999@gmail.com
ALERT_EMAIL_FROM=alertas@velaclasica.ar
# Minimum gap between two mails about the same failure, in seconds.
ALERT_THROTTLE_SECONDS=900

# How long Vercel's CDN may serve a public page without asking the function. This is
# the dial that decides Neon's CU-hour bill: every HTML render queries Postgres, and
# every query keeps the compute awake for another five minutes. Raising it costs
# freshness after a content edit (an admin always sees their own change at once);
# 0 disables CDN caching of HTML altogether.
CDN_CACHE_SECONDS=3600
CDN_STALE_SECONDS=86400

# CDN purge on save (docs/deploy/MONITORING.md). A Vercel token with cache-purge
# rights lets an admin's save clear the cached public pages immediately, which is
# what makes a long CDN_CACHE_SECONDS affordable. Unset, the purge is a logged
# no-op and CDN_CACHE_SECONDS becomes the full staleness window after an edit.
VERCEL_PURGE_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Publishing content triggers a deploy, because what the public sees ships inside the
# bundle as app/content/snapshot.json (docs/deploy/MONITORING.md). A fine-grained token
# scoped to this repo with `Actions: read and write` — NOT `Contents`, which would let
# whoever holds it push code. Unset, a publish saves to the database and alerts that it
# could not ask for the deploy: the content stays safe but unpublished.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=CROCDC/juana-maria-web
