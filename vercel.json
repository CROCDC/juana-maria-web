{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "rm -rf public/static && mkdir -p public && cp -R app/static public/static",
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
